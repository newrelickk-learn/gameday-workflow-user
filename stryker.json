{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/stryker-schema.json",
  "stryker-config": {
    "project": "src/UserService.Api/UserService.Api.csproj",
    "test-projects": [
      "tests/UserService.Api.Tests/UserService.Api.Tests.csproj"
    ],
    "reporters": [
      "html",
      "progress",
      "cleartext"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "**/*.cs"
    ],
    "files-to-exclude": [
      "**/Program.cs",
      "**/Migrations/**",
      "**/DbInitializer.cs"
    ],
    "coverage-analysis": "perTest"
  }
}

