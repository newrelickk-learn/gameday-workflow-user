{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=gameday_workflow_user;Username=gameday_user;Password=gameday_password"
  },
  "Jwt": {
    "SecretKey": "YourSuperSecretKeyThatShouldBeAtLeast32CharactersLong!",
    "Issuer": "UserService",
    "Audience": "UserService",
    "ExpirationMinutes": "60"
  },
  "InternalService": {
    "ApiKey": "InternalServiceApiKeyForGameDayWorkflow2024!"
  },
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 1000,
      "MaxConcurrentUpgradedConnections": 1000,
      "KeepAliveTimeoutSeconds": 120,
      "RequestHeadersTimeoutSeconds": 30,
      "MaxRequestBodySize": 10485760
    }
  },
  "ThreadPool": {
    "MinWorkerThreads": 0,
    "MaxWorkerThreads": 1000,
    "MinCompletionPortThreads": 0,
    "MaxCompletionPortThreads": 1000
  },
  "Database": {
    "MaxPoolSize": 200,
    "MinPoolSize": 10,
    "ConnectionLifetime": 0
  }
}

